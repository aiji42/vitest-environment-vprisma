{
  "name": "vitest-prisma",
  "version": "0.0.0-development",
  "description": "Isolate every Vitest test in a Prisma transaction and roll it back automatically.",
  "keywords": [
    "vitest",
    "prisma",
    "testing",
    "transaction",
    "rollback",
    "database"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "docs",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiji42/vitest-environment-vprisma.git"
  },
  "homepage": "https://github.com/aiji42/vitest-environment-vprisma#readme",
  "bugs": "https://github.com/aiji42/vitest-environment-vprisma/issues",
  "author": "aiji42 <aiji42@gmail.com> (https://twitter.com/aiji42_dev)",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack . --profile esm-only",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "vitest": ">=4.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^22.20.5",
    "publint": "^0.3.25",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "release": {
    "tagFormat": "vitest-prisma@${version}",
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
